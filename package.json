{
  "name": "mdpkg-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "verify": "bash scripts/verify.sh",
    "build:site": "node scripts/build-site.ts",
    "test:site": "node --test scripts/build-site.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0"
  },
  "version": "0.1.0.0"
}
